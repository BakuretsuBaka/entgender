{
  "manifest_version": 3,
  "name": "Entgender",
  "short_name": "Entgender",
  "version": "1.10.1",
  "description": "Entfernt Gendersprache auf Webseiten: Genderstern, Doppelpunkt, Binnen-I, Doppelformen. Open Source, ohne Datensammlung.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Entgender",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-off16.png",
      "48": "icons/icon-off48.png",
      "128": "icons/icon-off128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
